    (function enableDrag() {
        let sx = 0;
        let sy = 0;
        let ox = 0;
        let oy = 0;
        let dragging = false;

        const start = e => {
            if (e.target && e.target.id === 'btn-min') return;

            dragging = true;
            const r = ui.panel.getBoundingClientRect();

            ox = r.left;
            oy = r.top;
            sx = e.clientX;
            sy = e.clientY;

            ui.panel.style.right = 'auto';
            ui.panel.style.left = ox + 'px';
            ui.panel.style.top = oy + 'px';

            e.preventDefault();
        };

        const move = e => {
            if (!dragging) return;

            let x = ox + e.clientX - sx;
            let y = oy + e.clientY - sy;

            const w = ui.panel.offsetWidth;
            const h = ui.panel.offsetHeight;

            x = Math.max(
                4,
                Math.min(x, (window.innerWidth || 0) - w - 4)
            );

            y = Math.max(
                4,
                Math.min(y, (window.innerHeight || 0) - h - 4)
            );

            ui.panel.style.left = x + 'px';
            ui.panel.style.top = y + 'px';
        };

        const end = () => {
            if (!dragging) return;
            dragging = false;

            store.set(CFG.POS_STORE, {
                left: parseInt(ui.panel.style.left, 10) || 0,
                top: parseInt(ui.panel.style.top, 10) || 0,
            });
        };

        ui.hd.addEventListener('mousedown', start);
        window.addEventListener('mousemove', move);
        window.addEventListener('mouseup', end);

        const pos = store.get(CFG.POS_STORE, null);
        if (pos && typeof pos.left === 'number') {
            ui.panel.style.right = 'auto';
            ui.panel.style.left = pos.left + 'px';
            ui.panel.style.top = pos.top + 'px';
        }
    })();

