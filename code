    ui.btnCopy.addEventListener('click', copyAnswer);

    /* =====================================================================
     * 14. 自动填入
     * =================================================================== */

    function fillMessage(r) {
        if (!r) {
            return '答案已返回，但填入超时，请手动选择';
        }

        if (!r.total) {
            return '答案已返回；这道题没找到可填控件，请手动作答';
        }

        if (!r.filled) {
            return (
                '答案已返回，但没能填入（' +
                (r.note || '控件结构不匹配') +
                '）'
            );
        }

        return (
            '已自动填入 ' +
            r.filled +
            ' / ' +
            r.total +
            ' 处，请核对后手动提交'
        );
    }

    async function doFill() {
        if (!lastQ || !lastA) {
            setStatus('请先获取答案', 'warn');
            return;
        }

        ui.btnFill.disabled = true;
        setStatus('正在填入…');

        try {
            const r = await applyAnswer(lastQ, lastA);
            setStatus(
                fillMessage(r),
                r && r.filled > 0 ? 'ok' : 'warn'
            );
        } catch (e) {
            setStatus(
                '填入失败：' + ((e && e.message) || e),
                'err'
            );
        } finally {
            ui.btnFill.disabled = false;
        }
    }

    ui.btnFill.addEventListener('click', doFill);

    /* =====================================================================
     * 15. 自动提交与继续循环
     * =================================================================== */

    function normalizeCampusButtonText(text) {
        return String(text || '')
            .replace(/\s+/g, '')
            .replace(/[：:！!。]/g, '')
            .trim();
    }

    function findCampusButton(type) {
        const selectors = [
            'button',
            'input[type="button"]',
            'input[type="submit"]',
            '[role="button"]',
            'a'
        ];

        const names = type === 'submit'
            ? ['提交', '提交答案', '确认提交']
            : ['继续', '下一题', '继续学习', '继续答题', '进入下一题'];

        const candidates = [];

        selectors.forEach(selector => {
            document.querySelectorAll(selector).forEach(el => {
                if (!isVisible(el)) return;

                if (
                    el.disabled ||
                    el.getAttribute('aria-disabled') === 'true'
                ) return;

                const text = normalizeCampusButtonText(
                    el.tagName === 'INPUT'
                        ? el.value
                        : el.innerText || el.textContent
                );

                if (!names.includes(text)) return;
                if (!candidates.includes(el)) candidates.push(el);
            });
        });

        const realButtons = candidates.filter(el =>
            el.matches(
                'button,input[type="button"],input[type="submit"]'
            )
        );

        if (realButtons.length === 1) return realButtons[0];
        if (realButtons.length > 1) return null;

        return candidates.length === 1 ? candidates[0] : null;
    }

    function waitCampusButton(type, timeout = 20000) {
        return new Promise(resolve => {
            const start = Date.now();

            const timer = setInterval(() => {
                const button = findCampusButton(type);

                if (button) {
                    clearInterval(timer);
                    resolve(button);
                    return;
                }

                if (Date.now() - start >= timeout) {
                    clearInterval(timer);
                    resolve(null);
                }
            }, 300);
        });
    }

    async function waitNextCampusQuestion(oldText, timeout = 20000) {
        const start = Date.now();
        const oldSignature = hash(cleanText(oldText));

        while (Date.now() - start < timeout) {
            await new Promise(resolve => setTimeout(resolve, 700));

            const q = await extractQuestion();
            if (!q || !q.text) continue;

            const newSignature = hash(cleanText(q.text));
            if (newSignature !== oldSignature) return q;
        }

        return null;
    }

    async function onAsk() {
        if (busy) return;

        const key =
            getKey() ||
            String(ui.key.value || '').trim();

        if (!key) {
            setStatus('请先填写 Groq API Key 并保存', 'warn');
            ui.key.focus();
            return;
        }

        if (key !== getKey()) {
            store.set(CFG.KEY_STORE, key);
        }

        setBusy(true);

        try {
            let questionCount = 0;

            while (true) {
                // 每轮开始前检查暂停状态
                await waitIfPaused();

                questionCount++;

                setStatus('正在提取第 ' + questionCount + ' 道题…');

                const q = await extractQuestion();

                // 提取过程中如果按下暂停，在这里停住
                await waitIfPaused();

                if (!q || !q.text || q.text.length < 8) {
                    setStatus('没有识别到题目，答题循环结束', 'warn');
                    showPreview(null);
                    break;
                }

                showPreview(q);

                setStatus('已识别题目，正在请求 ' + getModel() + '…');
                setAnswer('请求中…', true);

                const answer = await getAnswer(q);

                // AI 请求结束后检查暂停状态
                await waitIfPaused();

                if (!answer) {
                    setAnswer('模型没有返回答案', true);
                    setStatus('没有获取到答案，循环结束', 'err');
                    break;
                }

                setAnswer(answer, false);
                lastQ = q;
                lastA = answer;
                ui.btnFill.disabled = false;

                if (!autoFillOn()) {
                    setStatus('答案已获取，自动填入未开启', 'ok');
                    break;
                }

                await waitIfPaused();

                setStatus('答案已获取，正在填入…');

                let result = null;

                try {
                    result = await applyAnswer(q, answer);
                } catch (e) {
                    result = null;
                }

                // 填入完成后检查暂停状态
                await waitIfPaused();

                if (!result || !result.total || !result.filled) {
                    setStatus(
                        '答案填入失败：' +
                        (
                            result && result.note
                                ? result.note
                                : '没有成功填入答案'
                        ) +
                        '，停止循环',
                        'err'
                    );
                    break;
                }

                setStatus(
                    '已填入 ' +
                    result.filled +
                    ' / ' +
                    result.total +
                    '，准备提交…',
                    'ok'
                );

                await new Promise(resolve => setTimeout(resolve, 800));
                await waitIfPaused();

                const submitButton = await waitCampusButton(
                    'submit',
                    20000
                );

                await waitIfPaused();

                if (!submitButton) {
                    setStatus('没有找到唯一的提交按钮，循环结束', 'warn');
                    break;
                }

                // 点击提交前再次确认没有暂停
                await waitIfPaused();
                submitButton.click();

                setStatus('已提交，等待判题结果…');

                const continueButton = await waitCampusButton(
                    'continue',
                    20000
                );

                await waitIfPaused();

                if (!continueButton) {
                    setStatus('没有找到继续按钮，循环结束', 'warn');
                    break;
                }

                const previousQuestionText = q.text;

                // 点击继续前再次确认没有暂停
                await waitIfPaused();
                continueButton.click();

                setStatus('已点击继续，正在等待下一题…');

                const nextQuestion = await waitNextCampusQuestion(
                    previousQuestionText,
                    20000
                );

                await waitIfPaused();

                if (!nextQuestion) {
                    setStatus('没有检测到新的题目，答题循环结束', 'ok');
                    break;
                }
            }

        } catch (err) {
            const msg =
                err && err.message
                    ? err.message
                    : String(err);

            setAnswer('❌ ' + msg, true);
            setStatus(msg, 'err');

        } finally {
            setBusy(false);
        }
    }

    ui.btnAsk.addEventListener('click', onAsk);

    /* =====================================================================
     * 16. 快捷键
     * =================================================================== */

    window.addEventListener('keydown', e => {
        if (!e.altKey || e.ctrlKey || e.metaKey) return;

        const k = (e.key || '').toLowerCase();

        if (k === 'q') {
            e.preventDefault();
            onAsk();
        } else if (k === 'f') {
            e.preventDefault();
            doFill();
        } else if (k === 'm') {
            e.preventDefault();
            ui.panel.hidden ? expand() : minimize();
        }
    });

    /* =====================================================================
     * 17. 启动
     * =================================================================== */

    if (!getKey()) {
        setStatus('首次使用：填写 Groq API Key 后点击保存', 'warn');
    } else {
        setStatus('Groq 已就绪 · Alt+Q 获取答案', null);
    }

})();